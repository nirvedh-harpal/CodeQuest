{
  "manifest_version": 3,
  "name": "CodeQuest - Competitive Programming Tracker",
  "description": "Save and organize coding problems from LeetCode, CodeForces, CodeChef, and more. Track your progress with Google Sheets integration.",
  "version": "1.03",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://leetcode.com/*",
    "https://www.codechef.com/*",
    "https://atcoder.jp/*",
    "https://www.interviewbit.com/*",
    "https://www.hackerrank.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon48.png",
      "48": "icons/icon48.png",
      "128": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon48.png",
    "48": "icons/icon48.png",
    "128": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://leetcode.com/*",
        "https://www.codechef.com/*",
        "https://atcoder.jp/*",
        "https://www.interviewbit.com/*",
        "https://www.hackerrank.com/*",
        "https://www.geeksforgeeks.org/*"
      ],
      "js": ["content.js"]
    }
  ],
  "options_page": "options.html"
}
