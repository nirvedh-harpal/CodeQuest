{
  "manifest_version": 3,
  "name": "CodeQuest: Save Coding Problems with Google Sheets — LeetCode, Codeforces, InterviewBit & More",
  "description": "Track, organize & save coding problems from LeetCode, Codeforces, CodeChef, AtCoder, HackerRank, InterviewBit & GeeksforGeeks. Auto-populate difficulty levels, tags with smart normalization. Seamless Google Sheets integration for progress tracking. Perfect for competitive programming, coding interviews & algorithm practice.",
  "version": "1.3.5",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://leetcode.com/*",
    "https://www.codechef.com/*",
    "https://atcoder.jp/*",
    "https://www.interviewbit.com/*",
    "https://www.hackerrank.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon48.png",
      "48": "icons/icon48.png",
      "128": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon48.png",
    "48": "icons/icon48.png",
    "128": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://leetcode.com/*",
        "https://www.codechef.com/*",
        "https://atcoder.jp/*",
        "https://www.interviewbit.com/*",
        "https://www.hackerrank.com/*",
        "https://www.geeksforgeeks.org/*"
      ],
      "js": ["tagMapper.js", "content.js"]
    }
  ],
  "options_page": "options.html"
}
